    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>NEXT_TELEMETRY_DISABLED</key>
    <string>1</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/alexgierczyk/Library/Logs/siftly-web.log</string>

  <key>StandardErrorPath</key>
