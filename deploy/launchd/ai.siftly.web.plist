<!--
  Staged only: do not load from a worker. G2/Apollo installs this after Ace approval.
  Proposed install: copy to ~/Library/LaunchAgents/ai.siftly.web.plist, then run
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/ai.siftly.web.plist

