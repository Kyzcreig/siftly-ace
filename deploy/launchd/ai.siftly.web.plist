    launchctl bootout gui/$(id -u)/ai.siftly.web || true
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/ai.siftly.web.plist
    curl -sf http://127.0.0.1:3000/api/stats
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.siftly.web</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/alexgierczyk/Projects/siftly-ace/scripts/web-server.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/alexgierczyk/Projects/siftly-ace</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>EnvironmentVariables</key>
